# Copy to .env.local (and add the same two values in Vercel -> Settings -> Environment Variables).
# Both are in the Supabase dashboard under Project Settings -> API. Leave them out to run without accounts.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
